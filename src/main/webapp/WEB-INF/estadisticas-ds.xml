<?xml version="1.0" encoding="UTF-8"?>
<datasources xmlns="http://www.jboss.org/ironjacamar/schema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.jboss.org/ironjacamar/schema http://docs.jboss.org/ironjacamar/schema/datasources_1_0.xsd">
    <datasource jndi-name="java:jboss/datasources/EstadisticasDS" pool-name="EstadisticasDS" enabled="true" use-java-context="true">
        <connection-url>jdbc:postgresql://localhost:5432/estadisticas_db</connection-url>
        <driver>postgresql</driver>
        <security>
            <user-name>estadisticas_user</user-name>
            <password>estadisticas_pass</password>
        </security>
    </datasource>
</datasources>
